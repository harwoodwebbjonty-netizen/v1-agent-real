ANTHROPIC_API_KEY=sk-ant-your-key-here
MODEL=claude-sonnet-4-6
EXTRACTION_MODEL=claude-haiku-4-5-20251001
RATE_LIMIT=10/minute
MAX_PAUSE_TURN_CONTINUATIONS=3

# AI Email Writer — real sending via OAuth. Leave blank to leave sending
# disabled (Connect buttons will show a clear "not configured" error).
#
# Gmail: Google Cloud Console -> APIs & Services -> Credentials -> OAuth
# Client ID (type: Web application). Enable the Gmail API. Add this exact
# redirect URI: http://localhost:8000/email-oauth/gmail/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft: Azure AD -> App registrations -> New registration. Add the
# Microsoft Graph "Mail.Send" delegated permission. Add this exact redirect
# URI: http://localhost:8000/email-oauth/microsoft/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Only change this if the backend isn't reachable at localhost:8000 for
# whoever is completing the OAuth flow in their browser.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Companies House REST API key — used for AI Prospecting and company lookups.
# Register at: https://developer.company-information.service.gov.uk (key type: REST)
# Leave blank to disable AI Prospecting.
COMPANIES_HOUSE_API_KEY=your-rest-api-key-here

# Companies House Streaming API key — separate key (type: Streaming) for the
# live charge feed. Falls back to COMPANIES_HOUSE_API_KEY if not set.
COMPANIES_HOUSE_STREAM_KEY=your-streaming-key-here

# Apify — runs the "LinkedIn Profile Posts scraper" actor so sales-intelligence
# research can use real LinkedIn post content instead of relying on web_fetch,
# which LinkedIn usually blocks. Get the token from Apify Console -> Settings
# -> Integrations, and the actor ID from the actor's own page -> API tab
# (format "username/actor-name"). Leave either blank to disable.
APIFY_API_TOKEN=your-apify-token-here
APIFY_LINKEDIN_ACTOR_ID=username/actor-name

# Encrypts stored Gmail/Microsoft OAuth tokens at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required — the backend will not start without this set.
TOKEN_ENCRYPTION_KEY=

# Sentry DSN for error tracking. Leave blank to disable — the backend runs
# fine without it, it just won't report errors anywhere but its own logs.
SENTRY_DSN=
