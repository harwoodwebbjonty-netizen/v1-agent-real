# Reverse proxy: public port 80 -> uvicorn on 127.0.0.1:8000.
# Install as /etc/nginx/sites-available/phone-lookup-backend, then:
#   ln -s /etc/nginx/sites-available/phone-lookup-backend /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# Once you have a domain pointed at this server, swap server_name below and
# run `certbot --nginx -d yourdomain.com` to upgrade this to HTTPS — certbot
# edits this file in place to add the TLS block, no other changes needed.

server {
    listen 80;
    server_name _;  # replace with yourdomain.com once you have one

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # nginx's 60s default is too short for requests that chain a
        # synchronous Apify LinkedIn scrape (up to 120s) with AI research/
        # generation calls — e.g. POST /win-back/campaigns/preview. Without
        # this, nginx returns 504 while the backend keeps running the
        # request anyway, wasting the Apify/Anthropic spend on a response
        # nobody receives.
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
