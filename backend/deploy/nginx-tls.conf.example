# TLS-ready reverse proxy — the target state once a real domain points at this
# server. Closes audit finding C2 (plain-HTTP transport).
#
# FINISH SEQUENCE (run on the VPS when you hand the app over for real use):
#   1. Point a domain's A record at 213.165.88.45 and wait for DNS to propagate.
#   2. Put YOUR domain in `server_name` below (both blocks), install this file as
#      /etc/nginx/sites-available/phone-lookup-backend, and `nginx -t`.
#   3. Issue a certificate — the easy path lets certbot edit nginx for you:
#        certbot --nginx -d yourdomain.com
#      (certbot fills in ssl_certificate / ssl_certificate_key and the redirect).
#   4. In the VPS backend/.env set:
#        PUBLIC_BASE_URL=https://yourdomain.com
#        OAUTH_REDIRECT_BASE_URL=https://yourdomain.com
#      then `systemctl restart phone-lookup-backend`. Update the desktop app's
#      backend base URL to the https domain too.
#   5. In Google/Microsoft OAuth consoles, set the redirect URI to
#        https://yourdomain.com/email-oauth/{gmail,microsoft}/callback
#      (Gmail's gmail.send scope generally requires HTTPS + a real domain — this
#      step is what unblocks Gmail sending).

# HTTP -> HTTPS redirect.
server {
    listen 80;
    server_name yourdomain.com;   # <-- replace
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name yourdomain.com;   # <-- replace

    # certbot --nginx fills these two lines in for you:
    # ssl_certificate     /etc/letsencrypt/live/yourdomain.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/yourdomain.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Long timeouts for requests that chain a synchronous Apify LinkedIn
        # scrape (up to 120s) with AI research/generation — see the HTTP config.
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
